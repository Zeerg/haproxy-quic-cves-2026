FROM debian:bookworm@sha256:854dd8ab51d62866dbd8f5431d15ce77b12983a2a4a1e1fe43a2395dc7ef9f61

ARG VERSION

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        libssl-dev \
        openssl \
    && rm -rf /var/lib/apt/lists/*

COPY vendor/haproxy-${VERSION}.tar.gz /tmp/haproxy.tar.gz
COPY vendor/haproxy-${VERSION}.tar.gz.sha256 /tmp/haproxy.tar.gz.sha256

RUN sed -i "s/haproxy-${VERSION}\.tar\.gz/haproxy.tar.gz/" /tmp/haproxy.tar.gz.sha256 \
    && cd /tmp \
    && sha256sum -c haproxy.tar.gz.sha256 \
    && mkdir /tmp/haproxy \
    && tar -xzf /tmp/haproxy.tar.gz --strip-components=1 -C /tmp/haproxy \
    && make -C /tmp/haproxy -j2 \
        TARGET=linux-glibc \
        USE_OPENSSL=1 \
        USE_QUIC=1 \
        USE_QUIC_OPENSSL_COMPAT=1 \
    && cp /tmp/haproxy/haproxy /usr/local/sbin/haproxy \
    && rm -rf /tmp/haproxy /tmp/haproxy.tar.gz /tmp/haproxy.tar.gz.sha256

COPY lab/haproxy.cfg /etc/haproxy.cfg
COPY lab/start-haproxy-lab.sh /usr/local/bin/start-haproxy-lab

EXPOSE 8443/udp

CMD ["/usr/local/bin/start-haproxy-lab"]
